#!/bin/sh
# =============================================
# OpenWrt 首次启动默认配置脚本
# LAN IP = 192.168.31.1
# WiFi 无密码（开放网络）
# 时区 = 上海 (Asia/Shanghai)
# =============================================

# ---------- LAN 配置 ----------
uci -q batch << EOI
delete network.lan
set network.lan=interface
set network.lan.device='br-lan'
set network.lan.proto='static'
set network.lan.ipaddr='192.168.31.1'
set network.lan.netmask='255.255.255.0'
set network.lan.ip6assign='60'

delete network.@device[0]
set network.@device[0]=device
set network.@device[0].name='br-lan'
set network.@device[0].type='bridge'
add_list network.@device[0].ports='eth0'     # ← 刷完后请告诉我实际端口，我帮你改
EOI
uci commit network

# ---------- DHCP 配置 ----------
uci -q batch << EOI
set dhcp.lan.start='100'
set dhcp.lan.limit='150'
set dhcp.lan.leasetime='12h'
EOI
uci commit dhcp

# ---------- WiFi 配置（无密码，完全开放） ----------
uci -q batch << EOI
set wireless.radio0.disabled='0'
set wireless.radio0.country='CN'

set wireless.radio1.disabled='0'
set wireless.radio1.country='CN'

set wireless.default_radio0.disabled='0'
set wireless.default_radio0.ssid='OpenWrt-31'
set wireless.default_radio0.encryption='none'

set wireless.default_radio1.disabled='0'
set wireless.default_radio1.ssid='OpenWrt-31-5G'
set wireless.default_radio1.encryption='none'
EOI
uci commit wireless

# ---------- 时区设置为上海 ----------
uci -q batch << EOI
set system.@system[0].timezone='CST-8'
set system.@system[0].zonename='Asia/Shanghai'
EOI
uci commit system

/etc/init.d/system restart
wifi reload
exit 0
